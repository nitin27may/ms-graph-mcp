# ms-graph-mcp configuration
#
# Copy to `.env` (gitignored) and fill in. Every setting is optional — the
# defaults run a local stdio server. `GRAPH_MCP_*` is canonical; the three
# app-registration fields also accept the conventional `AZURE_AD_*` names.
#
# NEVER commit a real token or secret. `.env` is gitignored; this file is not.

# ── stdio transport ───────────────────────────────────────────────────────────
# stdio has no per-request headers, so the single session's credentials come
# from the environment.

# RECOMMENDED: set CLIENT_ID + TENANT_ID below instead of a token, and the
# server signs you in through the browser on first use. Nothing to paste, and
# nothing that expires in an hour.
#
# A pre-acquired delegated Graph token. Only for CI, or when another component
# already holds one. Graph tokens last about an hour.
GRAPH_MCP_ACCESS_TOKEN=

# The caller's email. Used as a tenant-isolation key by some tools.
GRAPH_MCP_USER_EMAIL=

# "true" to expose and permit the 23 write tools — mail send/reply/forward,
# calendar create/update/cancel, file upload and sharing links, Teams messages,
# task and contact writes. Off by default: turning this on lets an LLM send mail
# and book meetings as the signed-in user. See docs/permissions.md.
GRAPH_MCP_WRITE_SCOPE=false

# ── HTTP transport ────────────────────────────────────────────────────────────

GRAPH_MCP_PORT=8094

# The public URL clients actually connect to, e.g.
# https://graph-mcp.example.com/mcp. Two effects, and the second one bites:
# it turns on RFC 9728 OAuth discovery, and it registers your hostname with the
# transport's DNS-rebinding protection. Left empty behind a proxy, every request
# is refused with 421 Misdirected Request. Localhost is always valid.
GRAPH_MCP_RESOURCE_URL=

# Additional accepted `Host` values, comma-separated. Only for names
# GRAPH_MCP_RESOURCE_URL does not already cover — a split-horizon DNS name, a
# service-mesh address, a second domain.
GRAPH_MCP_ALLOWED_HOSTS=

# Shared secret for machine-to-machine callers. When set, a caller presenting
# it as `Authorization: Bearer <secret>` takes the machine bypass, which is
# also what unlocks the internal tool tier. Empty = no gate.
GRAPH_MCP_SHARED_SECRET=

# ── Entra app registration ────────────────────────────────────────────────────
# For stdio these two are all you need: the server signs the user in
# interactively. The app must be a public client with redirect URI
# http://localhost and "Allow public client flows" enabled.

GRAPH_MCP_TENANT_ID=
GRAPH_MCP_CLIENT_ID=

# Delegated scopes requested at interactive sign-in. Read-only by default — a
# first run should not consent to sending mail. Add write scopes deliberately.
GRAPH_MCP_SCOPES=User.Read,Mail.Read,Calendars.Read,Files.Read.All,People.Read,Chat.Read,Tasks.Read,Notes.Read,Contacts.Read

# Skip the browser and always use device-code sign-in (SSH, containers).
GRAPH_MCP_FORCE_DEVICE_CODE=false

# Where the interactive sign-in is cached. Written owner-readable only.
GRAPH_MCP_CACHE_DIR=~/.ms-graph-mcp

# Only needed when the server performs its own OBO or client-credentials
# exchange (GRAPH_MCP_DOES_OBO=true, or the app-only internal probe).
GRAPH_MCP_CLIENT_SECRET=

# ── Token validation ──────────────────────────────────────────────────────────

# Verify the inbound JWT's signature against the tenant's JWKS.
# Defaults TRUE. Only turn it off for a local run with no JWKS connectivity —
# with it off, token signatures are not checked.
GRAPH_MCP_JWT_VERIFY=true

# ── Resource-server mode ──────────────────────────────────────────────────────
# When true, the server receives a token audienced to ITSELF and exchanges it
# for a Microsoft Graph token via the OAuth 2.0 On-Behalf-Of flow. Requires the
# tenant/client/secret above. When false (default), the caller is expected to
# forward an already-acquired Graph token.
GRAPH_MCP_DOES_OBO=false

# The audience to validate in OBO mode. Empty derives `api://<client_id>`.
GRAPH_MCP_AUDIENCE=

# Graph scopes requested during the OBO exchange. `.default` requests exactly
# the delegated permissions the app registration is consented for.
GRAPH_MCP_OBO_SCOPES=https://graph.microsoft.com/.default

# ── Behaviour ─────────────────────────────────────────────────────────────────

# Comma-separated recipient-domain allowlist for mail_send and mail_forward —
# the two tools where the caller chooses the recipients. Replies are not gated,
# because the thread already fixes who they go to. Checked before the Graph
# call, not after. Empty = no gate, any domain. Set this if writes are enabled.
GRAPH_MCP_SEND_EMAIL_ALLOWED_DOMAINS=

# Remove the write tier from this deployment entirely: write tools are never
# advertised and never dispatchable, whatever the caller asks for. Stronger than
# relying on callers to omit the write scope.
GRAPH_MCP_READ_ONLY=false

# Which tool profiles to expose: core (default), mail, calendar, meetings,
# files, chat, people, directory, tasks, notes, search, or all. Comma-separated.
# The default deliberately hides some workloads — set "all" for everything.
GRAPH_MCP_TOOLSETS=core

# Cap on files returned across a browse/selection.
GRAPH_MCP_BROWSE_MAX_FILES=500

# Log level. Everything goes to stderr at every level, including on stdio where
# stdout is the protocol channel. INFO adds one [Graph] line per call, which is
# the first thing to raise when a tool misbehaves.
GRAPH_MCP_LOG_LEVEL=WARNING

# Disable TLS verification on Graph calls. For corporate TLS-inspection
# proxies only — it turns off certificate validation.
GRAPH_MCP_DISABLE_SSL_VERIFY=false
